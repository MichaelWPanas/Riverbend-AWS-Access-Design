{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListClinicalPrefixOnly",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::riverbend-charts-111122223333",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "clinical/",
                        "clinical/*"
                    ]
                }
            }
        },
        {
            "Sid": "ReadClinicalObjects",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::riverbend-charts-111122223333/clinical/*"
        },
        {
            "Sid": "DecryptChartsWithCMK",
            "Effect": "Allow",
            "Action": "kms:Decrypt",
            "Resource": "arn:aws:kms:us-east-1:111122223333:key/EXAMPLE-KEY-ID"
        }
    ]
}
